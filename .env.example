# Copy to .env.local for development; set the same names in Vercel.
# Google OAuth Web application credentials
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=elwinchankw@gmail.com
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Cloudflare D1 (API token with Account / D1 / Edit for this account)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=

# Cloudflare R2 S3 credentials with Object Read & Write for this bucket
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
